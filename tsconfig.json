{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "jsx": "react",
    "outDir": "./build"
  },
  "references": [{ "path": "./tsconfig.inertia.json" }],
  // Frontend-code specs are type-checked by inertia/tsconfig.json (they import across the reference).
  "exclude": [
    "inertia/**",
    "node_modules/**",
    "build/**",
    "tests/unit/answer_queue.spec.ts",
    "tests/unit/timeline_layout.spec.ts"
  ]
}
